#!/bin/sh
# EchoJay plugin-repo pre-commit gate (29 Jul 2026).
#
# Added after a concurrency near-miss: a parallel session was editing
# PluginEditor.cpp in this shared checkout at the same time as client-gate
# work, and this repo (unlike echojay-saas) had no protection. The gate's
# FIRST job is therefore to print the branch it is committing to, loudly,
# every time - the same defence the saas gate carries.
#
# Its SECOND job is to run the repo's self-tests.
#
# NO SKIPS. The previous version skipped the suite when the tree was unbuilt,
# on the reasoning that a gate which fails on an unbuilt tree gets bypassed
# habitually. That reasoning was wrong in the way this project keeps being
# wrong: it made an unbuilt tree indistinguishable from a passing one, and the
# ejmap M0 commit sailed through printing "tests skipped" while the drift guard
# the plan names as the defence against shared-header drift had never run.
# An unbuilt or stale tree is now a HARD FAILURE with the command to fix it.
#
# SCOPE, so that "no skips" means something. A suite is in scope when the
# commit touches code it covers. Out of scope is not the same as skipped:
#   - touches Source/ or the root CMakeLists  -> workspace_roundtrip_test
#     (shared code: this is what both binaries compile)
#   - touches tools/ejmap/ or tools/ejextract/ -> ejmap-roundtrip-test
#   - on feat/ejmap, ejmap-roundtrip-test is ALWAYS in scope
# Every in-scope suite must build and pass, or the commit is blocked. A build
# failure counts as a gate failure: the schema drift guard is a static_assert,
# so drift shows up as a compile error, not a failing assertion.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass (emergencies only): git commit --no-verify

BRANCH=$(git branch --show-current)
echo "pre-commit gate: branch $BRANCH"

REPO=$(git rev-parse --show-toplevel)
STAGED=$(git diff --cached --name-only)
FAILED=0
RAN=""

# --- is anything newer than the artefact it produced? -----------------------
is_stale() {
  artefact="$1"; shift
  for d in "$@"; do
    [ -d "$d" ] || continue
    hit=$(find "$d" -type f \( -name '*.cpp' -o -name '*.h' -o -name '*.mm' -o -name 'CMakeLists.txt' \) \
            -newer "$artefact" -print -quit 2>/dev/null)
    [ -n "$hit" ] && { echo "$hit"; return 0; }
  done
  return 1
}

# --- suite 1: workspace round-trip (shared plugin code) ---------------------
if echo "$STAGED" | grep -qE '^(Source/|CMakeLists\.txt$)'; then
  RAN="$RAN workspace_roundtrip_test"
  LIB="$REPO/build/EchoJay_artefacts/Release/libEchoJay V2_SharedCode.a"
  if [ ! -f "$LIB" ] || [ ! -f "$REPO/build/compile_commands.json" ]; then
    echo "GATE FAIL: this commit touches shared plugin code but build/ is missing."
    echo "           Build it first:  ./reinstall-v2.sh"
    echo "           (was a SKIP before 29 Jul 2026; an unbuilt tree is not a pass)"
    FAILED=1
  elif s=$(is_stale "$LIB" "$REPO/Source"); then
    echo "GATE FAIL: build/ is stale. Newer than the built library: $s"
    echo "           Rebuild:  ./reinstall-v2.sh"
    FAILED=1
  else
    echo "  running workspace round-trip self-test..."
    out=$("$REPO/tools/workspace_roundtrip_test/build_and_run.sh" 2>&1)
    if [ $? -ne 0 ]; then
      echo "GATE FAIL: workspace_roundtrip_test"
      echo "$out" | tail -12
      FAILED=1
    else
      echo "  ok  workspace_roundtrip_test: $(echo "$out" | grep -iE 'pass|ok|self-test' | tail -1)"
    fi
  fi
fi

# --- suite 2: ejmap round-trip (the shared-header drift guard) --------------
# Plan section 1.4 and the risk register both name this as THE guard against
# EchoJayParamApply.h drifting away from what ejmap verified. M0 listed it and
# did not wire it. Wired here.
if [ "$BRANCH" = "feat/ejmap" ] || echo "$STAGED" | grep -qE '^tools/(ejmap|ejextract)/'; then
  RAN="$RAN ejmap-roundtrip-test"
  BUILD="$REPO/build-ejmap"
  TEST="$BUILD/tools/ejmap/ejmap-roundtrip-test_artefacts/RelWithDebInfo/ejmap-roundtrip-test"
  if [ ! -d "$BUILD" ]; then
    echo "GATE FAIL: build-ejmap/ is missing and this commit is in ejmap scope."
    echo "           cmake -B build-ejmap -DCMAKE_BUILD_TYPE=RelWithDebInfo"
    FAILED=1
  else
    echo "  building ejmap-roundtrip-test..."
    # Rebuild every time. The drift guard is a static_assert in a header, so it
    # fires at COMPILE time; running a stale binary would prove nothing.
    bout=$(cmake --build "$BUILD" --target ejmap-roundtrip-test -j8 2>&1)
    if [ $? -ne 0 ]; then
      echo "GATE FAIL: ejmap-roundtrip-test did not BUILD (this is what schema/header drift looks like)"
      echo "$bout" | grep -E 'error:|static assertion' | head -8
      FAILED=1
    elif [ ! -x "$TEST" ]; then
      echo "GATE FAIL: ejmap-roundtrip-test built but the binary is missing at $TEST"
      FAILED=1
    else
      echo "  running ejmap-roundtrip-test..."
      out=$("$TEST" 2>&1)
      if [ $? -ne 0 ]; then
        echo "GATE FAIL: ejmap-roundtrip-test"
        echo "$out" | tail -12
        FAILED=1
      else
        echo "  ok  ejmap-roundtrip-test: $(echo "$out" | grep -E 'checks' | tail -1)"
      fi
    fi
  fi
fi

# --- suite 3: the corpus audit ----------------------------------------------
#
# NOT A CODE TEST. It checks the MAPS on this machine for a control surface that
# belongs to a different plugin -- the defect that put SSL Fusion HF Compressor
# on the server carrying Dangerous BAX EQ Mix's six controls, submitted by hand,
# accepted with HTTP 200, and found only because two control counts matched.
#
# It runs on every ejmap commit because a corpus is not checked by suspicion. A
# map can be written wrong by a defect that does not exist yet, and the audit
# costs a second.
#
# ABSENT CORPUS IS OUT OF SCOPE, NOT A PASS. A clone with no ~/Library/ejmap has
# nothing to audit and says so; a corpus that exists is always audited.
if echo "$STAGED" | grep -qE '^tools/(ejmap|propose)/' || [ "$BRANCH" = "feat/ejmap" ]; then
  AUDIT="$REPO/tools/propose/audit_maps.py"
  CORPUS="$HOME/Library/ejmap/maps"
  if [ ! -f "$AUDIT" ]; then
    :
  elif [ ! -d "$CORPUS" ]; then
    echo "  audit_maps: no corpus at $CORPUS on this machine -- out of scope, not a pass"
  else
    RAN="$RAN audit_maps"
    echo "  running audit_maps..."
    aout=$(python3 "$AUDIT" 2>&1)
    if [ $? -ne 0 ]; then
      echo "GATE FAIL: audit_maps -- a map carries another plugin's control surface"
      echo "$aout" | sed -n '/CHECK 0/,$p' | head -30
      FAILED=1
    else
      echo "  ok  audit_maps: $(echo "$aout" | grep -E '^[0-9]+ map' | head -1), $(echo "$aout" | grep 'check 0 saw' | tr -s ' ')"
    fi
  fi
fi

if [ -z "$RAN" ]; then
  echo "  no suite in scope for these files (touches neither shared code nor tools/ejmap)"
fi

[ $FAILED -ne 0 ] && { echo "pre-commit gate: BLOCKED"; exit 1; }
echo "pre-commit gate: green ($RAN )"
exit 0
