#!/bin/sh
# EchoJay plugin-repo pre-commit gate (27 Jul 2026).
#
# Added after a concurrency near-miss: a parallel session was editing
# PluginEditor.cpp in this shared checkout at the same time as client-gate
# work, and this repo (unlike echojay-saas) had no protection. The gate's
# FIRST job is therefore to print the branch it is committing to, loudly,
# every time - the same defence the saas gate carries.
#
# Its SECOND job is to run the repo's self-tests. This is a C++ repo, so the
# suite is the workspace round-trip test (real objects, EJ_SELFTEST body).
# It links the release SharedCode lib. If that lib is missing the gate BUILDS
# it at -j 4 when build/ is configured, and FAILS when it is not; it no longer
# skips, because the skip printed green having tested nothing. Either way it
# prints the path it took (see "A MISSING ARCHIVE IS NEVER SILENT" below).
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass (emergencies only): git commit --no-verify

echo "pre-commit gate: branch $(git branch --show-current)"

# BUILD LOCK REFUSAL (13 Aug 2026). Twice in two days a commit or edit
# landed while reinstall-v2.sh was building this worktree: once producing a
# mixed-object artefact that stamped itself with a clean SHA (2.26.15), once
# failing this very gate by linking a half-written SharedCode archive. The
# gate catching it after the fact was luckier than it should be; a rule that
# depends on remembering is not a fix. The lock directory is the build's
# flight marker (see reinstall-v2.sh); while it exists, committing races
# the artefact, so the gate refuses outright.
if [ -e "$HOME/.echojay-build.lock" ]; then
  echo "GATE FAIL: ~/.echojay-build.lock is held - a reinstall is building."
  echo "  Committing mid-build races the artefact and links half-written libs."
  echo "  Wait for the build to finish. If you are CERTAIN none is running:"
  echo "    rm -rf ~/.echojay-build.lock"
  exit 1
fi

# --- Divergence notice (10 Aug 2026) -----------------------------------
# HANDOVER.md lives on feat/plugin-dashboard, which means the sessions most
# in need of it are the ones that cannot see it: a tree behind that branch
# has no such file to read. The doc cannot tell someone they are missing it.
# This can, because the ref is local even when the file is not checked out,
# so `git show` reaches the live copy from ANY tree without a stub to
# maintain or a doc to move out of version control.
#
# WARNING, NEVER A BLOCK. A hook that stops a commit gets --no-verify'd
# within a week and then it protects nothing; the same reasoning the
# unbuilt-tree SKIP below already carries.
#
# Reaches every tree because core.hooksPath is repo-wide -- but only once
# that tree's branch carries this file, since the path resolves per
# worktree. A tree far behind gets the notice on its first merge forward,
# not before.
HANDOVER_LINE=feat/plugin-dashboard
HOOK_CUR=$(git branch --show-current)
if [ "$HOOK_CUR" != "$HANDOVER_LINE" ] \
   && git rev-parse --verify -q "$HANDOVER_LINE" >/dev/null 2>&1; then
  HOOK_BEHIND=$(git rev-list --count "HEAD..$HANDOVER_LINE" 2>/dev/null || echo 0)
  HOOK_AHEAD=$(git rev-list --count "$HANDOVER_LINE..HEAD" 2>/dev/null || echo 0)
  if [ "${HOOK_BEHIND:-0}" -gt 0 ]; then
    echo "  NOTE  behind $HANDOVER_LINE by $HOOK_BEHIND commit(s); ahead by ${HOOK_AHEAD:-0}."
    echo "        Merge or rebase onto it BEFORE touching Source/ (HANDOVER section 5)."
    echo "        Read it from here without checking it out:"
    echo "          git show $HANDOVER_LINE:HANDOVER.md"
  fi
fi

REPO=$(git rev-parse --show-toplevel)
LIB="$REPO/build/EchoJay_artefacts/Release/libEchoJay V2_SharedCode.a"

# SHELL-ONLY SUITES RUN FIRST, BEFORE THE UNBUILT-TREE SKIP BELOW (3 Aug
# 2026). They need no library and no compile_commands.json, so letting the
# skip swallow them would take them dark for a reason that has nothing to do
# with them — the same shape as the bug reinstall_v2_test exists to catch. A
# gate that can skip everything should at least always run the suites that
# have no excuse not to.
for T in reinstall_v2_test; do
  RUNNER="$REPO/tools/$T/build_and_run.sh"
  [ -x "$RUNNER" ] || { echo "  SKIP  $T (not in this worktree)"; continue; }
  echo "  running $T..."
  # THE RUNNER'S STDERR GOES TO ITS OWN FILE (23 Sep 2026, open list 221).
  #
  # This used to be out=$("$RUNNER" 2>&1), which merged the suite's stdout with
  # EchoJay_NSLog output from the scanner and the chat harness. THE WINDOW
  # BELOW IS 12 LINES AND THE NOISE IS NOT EVENLY SPREAD: on the last green
  # mapfps run, 667 of 4,530 lines were NSLog and they CLUSTER AT THE END,
  # which is exactly where a failure is most likely to be pushed out. A failed
  # suite could report twelve lines of scanner chatter and nothing about what
  # broke, which is open list 199's defect made worse by unrelated output.
  #
  # ORDER MATTERS ON THE NEXT THREE LINES. Both assignments go BEFORE the
  # runner call, because the verdict below reads $?, and any command between
  # the call and the test would overwrite it.
  #
  # SAME PATH AND SAME NAMING AS tools/reinstall-v2.sh, deliberately, so there
  # is ONE convention rather than two. Both callers therefore write the SAME
  # file for a given suite: it reflects the most recent run by EITHER caller,
  # LAST WRITER WINS. That is accepted rather than overlooked; the file is a
  # convenience for reading the run you just did, not a history.
  GATE_ERR="$REPO/HANDOVER/gate-stderr-$T.log"
  mkdir -p "$REPO/HANDOVER"
  out=$("$RUNNER" 2>"$GATE_ERR")
  if [ $? -ne 0 ]; then
    echo "GATE FAIL: $T"
    echo "$out" | tail -12
    echo "  stderr from this run (scanner and chat logging): $GATE_ERR"
    exit 1
  fi
  # THE SUMMARY MAY BE ON STDERR (23 Sep 2026, open list 223). Splitting the
  # streams blanked this line for workspace_roundtrip_test, whose ENTIRE
  # output is one fprintf(stderr) in EchoJayWorkspace.cpp:1096, so $out held
  # nothing and tail -1 of nothing is nothing. LABELLED, NOT SILENT: a
  # fallback that prints the line without saying where it came from just
  # moves the blank somewhere nobody looks, and a blank where a result
  # belongs is open list 199's whole subject. NEVER PRINT AN EMPTY RESULT.
  #
  # WRITTEN TO SURVIVE set -e, WHICH NEITHER FILE SETS TODAY. Plain `if`
  # blocks and a readability guard, so no line here can exit the shell if
  # anyone adds errexit later. The first version used
  # `SUMMARY=$(tail -1 "$GATE_ERR" 2>/dev/null)`, and MEASURED under set -e
  # in both /bin/sh and /bin/zsh that exits when the file is absent: an
  # assignment takes the substitution's status, so the gate would have died
  # SILENTLY, with no output at all, AFTER the suite had already passed.
  #
  # && AND || ARE NOT MIRROR IMAGES HERE, and the asymmetry is not the
  # obvious one. `[ ... ] || X` is safe because the list returns 0 when its
  # test succeeds. `[ ... ] && X` was ALSO safe, but for an unrelated
  # reason: errexit does not fire on a non-final command of an AND-OR list,
  # measured in both shells. Two different reasons for two lines that look
  # symmetrical is exactly the kind of thing to stop relying on, so neither
  # form is used below.
  SUMMARY=$(echo "$out" | tail -1)
  if [ -z "$SUMMARY" ] && [ -r "$GATE_ERR" ]; then
    SUMMARY=$(tail -1 "$GATE_ERR")
    if [ -n "$SUMMARY" ]; then SUMMARY="(stderr) $SUMMARY"; fi
  fi
  if [ -z "$SUMMARY" ]; then SUMMARY="(NO SUMMARY on stdout or stderr; see $GATE_ERR)"; fi
  echo "  ok  $T: $SUMMARY"
done

# A MISSING ARCHIVE IS NEVER SILENT (18 Sep 2026). This block used to print a
# SKIP and exit 0 when the archive was absent, so the gate reported success
# having tested nothing. On 17 Sep a clean removed the archive, and every
# commit after it would have passed green on the shell suite alone. There are
# now three paths, and the gate prints which one it took, so a green gate that
# skipped cannot be read again:
#   archive-present  the archive is there; the suites run against it
#   built            it is missing but build/ is configured: build it, at -j 4,
#                    announced before it starts, and fail if that fails
#   refused          it is missing and build/ is not configured: nothing can be
#                    built, so the commit FAILS rather than passing untested
# -j 4 for the reason given at tools/mapfps_test/build_and_run.sh step 1: at
# -j 4 this archive peaked at 5.70 GiB on a 16 GiB machine.
if [ -f "$LIB" ] && [ -f "$REPO/build/compile_commands.json" ]; then
  echo "  gate path: archive-present (suites run against the existing SharedCode archive)"
elif [ -f "$REPO/build/CMakeCache.txt" ]; then
  echo "  gate path: built (SharedCode archive missing; building target EchoJay at -j 4 now, before the suites)"
  out=$(cmake --build "$REPO/build" --target EchoJay -j 4 2>&1)
  if [ $? -ne 0 ] || [ ! -f "$LIB" ] || [ ! -f "$REPO/build/compile_commands.json" ]; then
    echo "GATE FAIL: the SharedCode archive could not be built"
    echo "$out" | grep -iE 'error' | head -12
    exit 1
  fi
  echo "  ok  SharedCode archive built"
else
  echo "  gate path: refused (SharedCode archive missing and build/ is not configured, so nothing can be built or tested)"
  echo "GATE FAIL: no SharedCode archive, and no configured build/ to make one"
  echo "  configure it (cmake -S . -B build -DCMAKE_BUILD_TYPE=Release) and commit again;"
  echo "  the gate then builds the archive itself, at -j 4"
  exit 1
fi

# BUILD-DEPENDENT SUITES (12 Aug 2026: mapfps_test joins the roundtrip
# test). mapfps_test carries the structural check that both ChainHost call
# sites go through fpForIdentity; a wiring regression should fail HERE, at
# commit, not survive until the next install run catches it.
for T in workspace_roundtrip_test mapfps_test; do
  RUNNER="$REPO/tools/$T/build_and_run.sh"
  [ -x "$RUNNER" ] || { echo "  SKIP  $T (not in this worktree)"; continue; }
  echo "  running $T..."
  # THE RUNNER'S STDERR GOES TO ITS OWN FILE (23 Sep 2026, open list 221).
  #
  # This used to be out=$("$RUNNER" 2>&1), which merged the suite's stdout with
  # EchoJay_NSLog output from the scanner and the chat harness. THE WINDOW
  # BELOW IS 12 LINES AND THE NOISE IS NOT EVENLY SPREAD: on the last green
  # mapfps run, 667 of 4,530 lines were NSLog and they CLUSTER AT THE END,
  # which is exactly where a failure is most likely to be pushed out. A failed
  # suite could report twelve lines of scanner chatter and nothing about what
  # broke, which is open list 199's defect made worse by unrelated output.
  #
  # ORDER MATTERS ON THE NEXT THREE LINES. Both assignments go BEFORE the
  # runner call, because the verdict below reads $?, and any command between
  # the call and the test would overwrite it.
  #
  # SAME PATH AND SAME NAMING AS tools/reinstall-v2.sh, deliberately, so there
  # is ONE convention rather than two. Both callers therefore write the SAME
