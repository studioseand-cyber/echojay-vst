#!/bin/bash
# A commit that does not compile must not leave this machine (Sean's ruling, 29 Oct 2026).
# The reasoning, and what it cost, are at the top of tools/push_guard/syntax_changed.sh.
# Enable with: git config core.hooksPath .githooks
set -u
ROOT="$(git rev-parse --show-toplevel)"
STATUS=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue                       # a delete carries no commits
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    RANGE="$local_sha~1..$local_sha"                            # a new branch: its tip
  else
    RANGE="$remote_sha..$local_sha"
  fi
  echo "push-guard: checking $RANGE ($local_ref)"
  bash "$ROOT/tools/push_guard/syntax_changed.sh" "$RANGE" || STATUS=1
done
exit $STATUS
