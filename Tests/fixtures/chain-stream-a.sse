data: {"type":"delta","block":"text","text":" de-essing\",\"settings_structured\":{\"low_cut_freq_hz\":100}},{\"name\":\"TDR Nova\",\"role\":\"Dynamic de-esser\",\"settings\":\"Set a dynamic"}

data: {"type":"delta","block":"text","text":" band centred around 7–9kHz, threshold pulled down until "}

data: {"type":"delta","block":"text","text":"3–5dB of reduction triggers on the loudest esses only; keep the band"}

data: {"type":"delta","block":"text","text":" narrow (high Q) so surrounding air isn't touched\"},{\"name\":\"Kotelnikov\",\"role\":\"Compression\",\"settings\":\"Medium"}

