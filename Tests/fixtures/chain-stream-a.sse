data: {"type":"delta","block":"text","text":"band dynamics.\n\n<<<ECHOJAY_CHAIN>>>{\"chain\":[{\"name\":\"TDR Nova\",\"role\":\"Corrective EQ\",\"settings\":\"High-pass around 100Hz to clear low"}

data: {"type":"delta","block":"text","text":"-end clutter; small cut 2–3dB around 250–"}

